# ----------------------------------------------------------------------------
# Database - Microsoft SQL Server
# ----------------------------------------------------------------------------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=ChangeMe_123
SQL_SERVER_DATABASE=ImportMS

DATABASE_URL="sqlserver://localhost:1433;database=ImportMS;user=sa;password=ChangeMe_123;encrypt=true;trustServerCertificate=true;connectionLimit=20"

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-32-byte-random-string-before-deploy
AUTH_SESSION_TTL_MINUTES=480
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
BCRYPT_COST=12

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="ImportMS Freight ERP"
APP_URL=http://localhost:3000
APP_BASE_CURRENCY=USD
NODE_ENV=development

# ----------------------------------------------------------------------------
# File storage
# ----------------------------------------------------------------------------
UPLOAD_ROOT=./storage/uploads
UPLOAD_MAX_BYTES=15728640
