model Expense {
  id            String   @id @default(cuid()) @db.NVarChar(30)
  expenseNo     String   @db.NVarChar(40)
  categoryId    String   @db.NVarChar(30)
  shipmentId    String?  @db.NVarChar(30)
  expenseDate   DateTime @db.DateTime2
  description   String   @db.NVarChar(300)
  currencyCode  String   @default("PKR") @db.NVarChar(3)
  exchangeRate  Decimal  @default(1) @db.Decimal(18, 8)
  amount        Decimal  @db.Decimal(18, 4)
  taxAmount     Decimal  @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal  @db.Decimal(18, 4)
  baseAmount    Decimal  @db.Decimal(18, 4)
  paymentMethod String   @default("CASH") @db.NVarChar(30)
  status        String   @default("RECORDED") @db.NVarChar(30)
  isLandedCost  Boolean  @default(true)
  referenceNo   String?  @db.NVarChar(80)
  documentKey   String?  @db.NVarChar(400)

  approvedById String?   @db.NVarChar(30)
  approvedAt   DateTime? @db.DateTime2

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipment Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([expenseNo], map: "UQ_Expenses_ExpenseNo")
  @@index([categoryId], map: "IX_Expenses_CategoryId")
  @@index([expenseDate], map: "IX_Expenses_ExpenseDate")
  @@index([shipmentId], map: "IX_Expenses_ShipmentId")
  @@map("Expenses")
}

// ---------------------------------------------------------------------------
// Goods receipt and inventory
//
// Receiving is the end of the costing journey. Each received line carries the
// landed unit cost calculated for its shipment line, and stock is valued at
// that cost using a weighted average per product and warehouse.
// ---------------------------------------------------------------------------

model GoodsReceipt {
  id          String   @id @default(cuid()) @db.NVarChar(30)
  receiptNo   String   @db.NVarChar(40)
  shipmentId  String   @db.NVarChar(30)
  warehouseId String   @db.NVarChar(30)
  receiptDate DateTime @db.DateTime2
  status      String   @default("DRAFT") @db.NVarChar(30)

  totalQuantity Decimal @default(0) @db.Decimal(18, 3)
  totalCost     Decimal @default(0) @db.Decimal(18, 4)

  postedAt     DateTime? @db.DateTime2
  cancelledAt  DateTime? @db.DateTime2
  cancelReason String?   @db.NVarChar(400)
  remarks      String?   @db.NVarChar(Max)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  shipment  Shipment           @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items     GoodsReceiptItem[]

  @@unique([receiptNo], map: "UQ_GoodsReceipts_ReceiptNo")
  @@index([shipmentId], map: "IX_GoodsReceipts_ShipmentId")
  @@index([receiptDate], map: "IX_GoodsReceipts_ReceiptDate")
  @@index([status, deletedAt], map: "IX_GoodsReceipts_Status_DeletedAt")
  @@map("GoodsReceipts")
}

model GoodsReceiptItem {
  id             String @id @default(cuid()) @db.NVarChar(30)
  goodsReceiptId String @db.NVarChar(30)
  shipmentItemId String @db.NVarChar(30)
  productId      String @db.NVarChar(30)
  lineNumber     Int

  quantityReceived Decimal @default(0) @db.Decimal(18, 3)
  quantityDamaged  Decimal @default(0) @db.Decimal(18, 3)
  unitLandedCost   Decimal @default(0) @db.Decimal(18, 4)
  totalCost        Decimal @default(0) @db.Decimal(18, 4)
  batchNo          String? @db.NVarChar(60)
  remarks          String? @db.NVarChar(300)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shipmentItem ShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product      Product      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([goodsReceiptId, lineNumber], map: "UQ_GoodsReceiptItems_Receipt_Line")
  @@index([productId], map: "IX_GoodsReceiptItems_ProductId")
  @@index([shipmentItemId], map: "IX_GoodsReceiptItems_ShipmentItemId")
  @@map("GoodsReceiptItems")
}

model StockBalance {
  id              String  @id @default(cuid()) @db.NVarChar(30)
  productId       String  @db.NVarChar(30)
  warehouseId     String  @db.NVarChar(30)
  quantityOnHand  Decimal @default(0) @db.Decimal(18, 3)
  averageUnitCost Decimal @default(0) @db.Decimal(18, 4)
  totalValue      Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, warehouseId], map: "UQ_StockBalances_Product_Warehouse")
  @@index([warehouseId], map: "IX_StockBalances_WarehouseId")
  @@map("StockBalances")
}

model StockMovement {
  id            String   @id @default(cuid()) @db.NVarChar(30)
  productId     String   @db.NVarChar(30)
  warehouseId   String   @db.NVarChar(30)
  movementType  String   @db.NVarChar(30)
  movementDate  DateTime @db.DateTime2
  quantity      Decimal  @db.Decimal(18, 3)
  unitCost      Decimal  @default(0) @db.Decimal(18, 4)
  totalCost     Decimal  @default(0) @db.Decimal(18, 4)
  balanceAfter  Decimal  @default(0) @db.Decimal(18, 3)
  referenceType String   @db.NVarChar(40)
  referenceId   String   @db.NVarChar(30)
  referenceNo   String   @db.NVarChar(40)
  shipmentId    String?  @db.NVarChar(30)
  narration     String?  @db.NVarChar(300)
  isReversal    Boolean  @default(false)

  createdAt   DateTime @default(now()) @db.DateTime2
  createdById String?  @db.NVarChar(30)

  product   Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId, movementDate], map: "IX_StockMovements_Product_Date")
  @@index([referenceType, referenceId], map: "IX_StockMovements_Reference")
  @@index([shipmentId], map: "IX_StockMovements_ShipmentId")
  @@map("StockMovements")
}

// ---------------------------------------------------------------------------
// Payables ledger
//
// One append-only statement per party and currency. Balance is debit minus
// credit, so a positive balance is money we still owe.
// ---------------------------------------------------------------------------

model LedgerAccount {
  id           String  @id @default(cuid()) @db.NVarChar(30)
  partyType    String  @db.NVarChar(30)
  partyId      String  @db.NVarChar(30)
  partyName    String  @db.NVarChar(180)
  currencyCode String  @db.NVarChar(3)
  debitTotal   Decimal @default(0) @db.Decimal(18, 4)
  creditTotal  Decimal @default(0) @db.Decimal(18, 4)
  balance      Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  entries LedgerEntry[]

  @@unique([partyType, partyId, currencyCode], map: "UQ_LedgerAccounts_Party_Currency")
  @@index([partyType], map: "IX_LedgerAccounts_PartyType")
  @@map("LedgerAccounts")
}

model LedgerEntry {
  id              String   @id @default(cuid()) @db.NVarChar(30)
  ledgerAccountId String   @db.NVarChar(30)
  entryDate       DateTime @db.DateTime2
  entryType       String   @db.NVarChar(40)
  referenceType   String   @db.NVarChar(40)
  referenceId     String   @db.NVarChar(30)
  referenceNo     String   @db.NVarChar(40)
  narration       String   @db.NVarChar(400)
  currencyCode    String   @db.NVarChar(3)
  exchangeRate    Decimal  @default(1) @db.Decimal(18, 8)
  debit           Decimal  @default(0) @db.Decimal(18, 4)
  credit          Decimal  @default(0) @db.Decimal(18, 4)
  balanceAfter    Decimal  @db.Decimal(18, 4)
  baseDebit       Decimal  @default(0) @db.Decimal(18, 4)
  baseCredit      Decimal  @default(0) @db.Decimal(18, 4)
  shipmentId      String?  @db.NVarChar(30)
  isReversal      Boolean  @default(false)
  reversedEntryId String?  @db.NVarChar(30)

  createdAt   DateTime @default(now()) @db.DateTime2
  createdById String?  @db.NVarChar(30)

  account LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ledgerAccountId, entryDate], map: "IX_LedgerEntries_Account_Date")
  @@index([referenceType, referenceId], map: "IX_LedgerEntries_Reference")
  @@index([shipmentId], map: "IX_LedgerEntries_ShipmentId")
  @@map("LedgerEntries")
}

model CompanyProfile {
  id             String  @id @default(cuid()) @db.NVarChar(30)
  legalName      String  @db.NVarChar(180)
  tradingName    String? @db.NVarChar(180)
  taxNumber      String? @db.NVarChar(60)
  registrationNo String? @db.NVarChar(60)
  email          String? @db.NVarChar(180)
  phone          String? @db.NVarChar(40)
  website        String? @db.NVarChar(180)
  addressLine1   String? @db.NVarChar(200)
  addressLine2   String? @db.NVarChar(200)
  city           String? @db.NVarChar(80)
  country        String? @db.NVarChar(80)
  baseCurrency   String  @default("PKR") @db.NVarChar(3)
  logoKey        String? @db.NVarChar(400)

  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2
  updatedById String?  @db.NVarChar(30)

  @@map("CompanyProfile")
}
