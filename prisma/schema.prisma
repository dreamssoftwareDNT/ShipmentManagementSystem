generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access control
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid()) @db.NVarChar(30)
  employeeCode      String?   @db.NVarChar(30)
  fullName          String    @db.NVarChar(150)
  email             String    @db.NVarChar(180)
  phone             String?   @db.NVarChar(30)
  passwordHash      String    @db.NVarChar(255)
  status            String    @default("ACTIVE") @db.NVarChar(30)
  isSystemAccount   Boolean   @default(false)
  lastLoginAt       DateTime? @db.DateTime2
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime? @db.DateTime2
  passwordChangedAt DateTime? @db.DateTime2

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  roles         UserRole[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]

  @@unique([email], map: "UQ_Users_Email")
  @@unique([employeeCode], map: "UQ_Users_EmployeeCode")
  @@index([status], map: "IX_Users_Status")
  @@index([deletedAt], map: "IX_Users_DeletedAt")
  @@map("Users")
}

model Role {
  id          String  @id @default(cuid()) @db.NVarChar(30)
  code        String  @db.NVarChar(50)
  name        String  @db.NVarChar(100)
  description String? @db.NVarChar(400)
  isSystem    Boolean @default(false)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  users       UserRole[]
  permissions RolePermission[]

  @@unique([code], map: "UQ_Roles_Code")
  @@index([deletedAt], map: "IX_Roles_DeletedAt")
  @@map("Roles")
}

model Permission {
  id          String  @id @default(cuid()) @db.NVarChar(30)
  module      String  @db.NVarChar(60)
  action      String  @db.NVarChar(30)
  code        String  @db.NVarChar(90)
  description String? @db.NVarChar(300)

  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  roles RolePermission[]

  @@unique([code], map: "UQ_Permissions_Code")
  @@index([module], map: "IX_Permissions_Module")
  @@map("Permissions")
}

model RolePermission {
  id           String @id @default(cuid()) @db.NVarChar(30)
  roleId       String @db.NVarChar(30)
  permissionId String @db.NVarChar(30)

  createdAt   DateTime @default(now()) @db.DateTime2
  createdById String?  @db.NVarChar(30)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId], map: "UQ_RolePermissions_Role_Permission")
  @@index([permissionId], map: "IX_RolePermissions_PermissionId")
  @@map("RolePermissions")
}

model UserRole {
  id     String @id @default(cuid()) @db.NVarChar(30)
  userId String @db.NVarChar(30)
  roleId String @db.NVarChar(30)

  createdAt   DateTime @default(now()) @db.DateTime2
  createdById String?  @db.NVarChar(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId], map: "UQ_UserRoles_User_Role")
  @@index([roleId], map: "IX_UserRoles_RoleId")
  @@map("UserRoles")
}

model Session {
  id         String    @id @default(cuid()) @db.NVarChar(30)
  userId     String    @db.NVarChar(30)
  tokenHash  String    @db.NVarChar(255)
  ipAddress  String?   @db.NVarChar(64)
  userAgent  String?   @db.NVarChar(400)
  expiresAt  DateTime  @db.DateTime2
  revokedAt  DateTime? @db.DateTime2
  lastSeenAt DateTime  @default(now()) @db.DateTime2

  createdAt DateTime @default(now()) @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tokenHash], map: "UQ_Sessions_TokenHash")
  @@index([userId, expiresAt], map: "IX_Sessions_User_Expiry")
  @@map("Sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.NVarChar(30)
  userId    String    @db.NVarChar(30)
  tokenHash String    @db.NVarChar(255)
  expiresAt DateTime  @db.DateTime2
  usedAt    DateTime? @db.DateTime2
  requestIp String?   @db.NVarChar(64)

  createdAt DateTime @default(now()) @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tokenHash], map: "UQ_PasswordResetTokens_TokenHash")
  @@index([userId], map: "IX_PasswordResetTokens_UserId")
  @@map("PasswordResetTokens")
}

model LoginAttempt {
  id         String  @id @default(cuid()) @db.NVarChar(30)
  email      String  @db.NVarChar(180)
  userId     String? @db.NVarChar(30)
  successful Boolean
  reason     String? @db.NVarChar(120)
  ipAddress  String? @db.NVarChar(64)
  userAgent  String? @db.NVarChar(400)

  createdAt DateTime @default(now()) @db.DateTime2

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email, createdAt], map: "IX_LoginAttempts_Email_CreatedAt")
  @@map("LoginAttempts")
}

model AuditLog {
  id         String  @id @default(cuid()) @db.NVarChar(30)
  entityName String  @db.NVarChar(80)
  entityId   String  @db.NVarChar(60)
  action     String  @db.NVarChar(40)
  summary    String? @db.NVarChar(400)
  changes    String? @db.NVarChar(Max)
  userId     String? @db.NVarChar(30)
  ipAddress  String? @db.NVarChar(64)

  createdAt DateTime @default(now()) @db.DateTime2

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityName, entityId], map: "IX_AuditLogs_Entity")
  @@index([createdAt], map: "IX_AuditLogs_CreatedAt")
  @@map("AuditLogs")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Currency {
  id           String  @id @default(cuid()) @db.NVarChar(30)
  code         String  @db.NVarChar(3)
  name         String  @db.NVarChar(80)
  symbol       String? @db.NVarChar(8)
  decimalScale Int     @default(2)
  isBase       Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  ratesFrom CurrencyRate[] @relation("CurrencyRateFrom")
  ratesTo   CurrencyRate[] @relation("CurrencyRateTo")

  @@unique([code], map: "UQ_Currencies_Code")
  @@map("Currencies")
}

model CurrencyRate {
  id             String   @id @default(cuid()) @db.NVarChar(30)
  fromCurrencyId String   @db.NVarChar(30)
  toCurrencyId   String   @db.NVarChar(30)
  rate           Decimal  @db.Decimal(18, 8)
  effectiveFrom  DateTime @db.DateTime2
  source         String?  @db.NVarChar(60)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  fromCurrency Currency @relation("CurrencyRateFrom", fields: [fromCurrencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toCurrency   Currency @relation("CurrencyRateTo", fields: [toCurrencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fromCurrencyId, toCurrencyId, effectiveFrom], map: "UQ_CurrencyRates_Pair_Effective")
  @@index([effectiveFrom], map: "IX_CurrencyRates_EffectiveFrom")
  @@map("CurrencyRates")
}

model NumberSequence {
  id         String @id @default(cuid()) @db.NVarChar(30)
  key        String @db.NVarChar(60)
  prefix     String @db.NVarChar(20)
  period     String @db.NVarChar(10)
  lastNumber Int    @default(0)
  padding    Int    @default(6)

  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  @@unique([key, period], map: "UQ_NumberSequences_Key_Period")
  @@map("NumberSequences")
}

model VendorType {
  id          String  @id @default(cuid()) @db.NVarChar(30)
  code        String  @db.NVarChar(40)
  name        String  @db.NVarChar(100)
  description String? @db.NVarChar(300)
  isSupplier  Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  vendors Vendor[]

  @@unique([code], map: "UQ_VendorTypes_Code")
  @@map("VendorTypes")
}

model ExpenseCategory {
  id           String  @id @default(cuid()) @db.NVarChar(30)
  code         String  @db.NVarChar(40)
  name         String  @db.NVarChar(100)
  costGroup    String  @default("OTHER") @db.NVarChar(40)
  isLandedCost Boolean @default(true)
  isActive     Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  expenses Expense[]

  @@unique([code], map: "UQ_ExpenseCategories_Code")
  @@map("ExpenseCategories")
}

model ServiceCharge {
  id          String  @id @default(cuid()) @db.NVarChar(30)
  code        String  @db.NVarChar(40)
  name        String  @db.NVarChar(120)
  defaultRate Decimal @default(0) @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(9, 4)
  costGroup   String  @default("OTHER") @db.NVarChar(40)
  isActive    Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  @@unique([code], map: "UQ_ServiceCharges_Code")
  @@map("ServiceCharges")
}

model Warehouse {
  id       String  @id @default(cuid()) @db.NVarChar(30)
  code     String  @db.NVarChar(30)
  name     String  @db.NVarChar(120)
  address  String? @db.NVarChar(300)
  city     String? @db.NVarChar(80)
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  goodsReceipts  GoodsReceipt[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([code], map: "UQ_Warehouses_Code")
  @@map("Warehouses")
}

// ---------------------------------------------------------------------------
// Product catalogue
// ---------------------------------------------------------------------------

model ProductCategory {
  id       String  @id @default(cuid()) @db.NVarChar(30)
  code     String  @db.NVarChar(40)
  name     String  @db.NVarChar(120)
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  products Product[]

  @@unique([code], map: "UQ_ProductCategories_Code")
  @@map("ProductCategories")
}

model Product {
  id            String  @id @default(cuid()) @db.NVarChar(30)
  sku           String  @db.NVarChar(60)
  name          String  @db.NVarChar(200)
  categoryId    String? @db.NVarChar(30)
  description   String? @db.NVarChar(Max)
  unitOfMeasure String  @default("PCS") @db.NVarChar(20)
  hsCode        String? @db.NVarChar(30)
  barcode       String? @db.NVarChar(60)
  brand         String? @db.NVarChar(120)
  unitWeightKg  Decimal @default(0) @db.Decimal(18, 3)
  unitVolumeCbm Decimal @default(0) @db.Decimal(18, 4)
  reorderLevel  Decimal @default(0) @db.Decimal(18, 3)
  isActive      Boolean @default(true)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  category       ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipmentItems  ShipmentItem[]
  receiptItems   GoodsReceiptItem[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([sku], map: "UQ_Products_Sku")
  @@index([name], map: "IX_Products_Name")
  @@index([categoryId], map: "IX_Products_CategoryId")
  @@index([isActive, deletedAt], map: "IX_Products_Active_DeletedAt")
  @@map("Products")
}

// ---------------------------------------------------------------------------
// Suppliers and service providers
// ---------------------------------------------------------------------------

model Vendor {
  id              String  @id @default(cuid()) @db.NVarChar(30)
  code            String  @db.NVarChar(30)
  vendorTypeId    String  @db.NVarChar(30)
  name            String  @db.NVarChar(150)
  companyName     String? @db.NVarChar(180)
  contactPerson   String? @db.NVarChar(120)
  email           String? @db.NVarChar(180)
  phone           String? @db.NVarChar(40)
  addressLine1    String? @db.NVarChar(200)
  addressLine2    String? @db.NVarChar(200)
  city            String? @db.NVarChar(80)
  country         String? @db.NVarChar(80)
  taxNumber       String? @db.NVarChar(60)
  currencyCode    String  @default("USD") @db.NVarChar(3)
  paymentTermDays Int     @default(30)
  status          String  @default("ACTIVE") @db.NVarChar(30)
  scacCode        String? @db.NVarChar(20)
  notes           String? @db.NVarChar(Max)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  vendorType        VendorType      @relation(fields: [vendorTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrders    PurchaseOrder[]
  invoices          VendorInvoice[]
  payments          VendorPayment[]
  suppliedShipments Shipment[]      @relation("ShipmentSupplier")
  carriedShipments  Shipment[]      @relation("ShipmentCarrier")

  @@unique([code], map: "UQ_Vendors_Code")
  @@index([vendorTypeId], map: "IX_Vendors_VendorTypeId")
  @@index([name], map: "IX_Vendors_Name")
  @@index([status, deletedAt], map: "IX_Vendors_Status_DeletedAt")
  @@map("Vendors")
}

model ClearingAgent {
  id              String  @id @default(cuid()) @db.NVarChar(30)
  code            String  @db.NVarChar(30)
  name            String  @db.NVarChar(150)
  companyName     String? @db.NVarChar(180)
  licenseNumber   String? @db.NVarChar(60)
  contactPerson   String? @db.NVarChar(120)
  email           String? @db.NVarChar(180)
  phone           String? @db.NVarChar(40)
  addressLine1    String? @db.NVarChar(200)
  city            String? @db.NVarChar(80)
  country         String? @db.NVarChar(80)
  portOfOperation String? @db.NVarChar(120)
  currencyCode    String  @default("PKR") @db.NVarChar(3)
  paymentTermDays Int     @default(15)
  status          String  @default("ACTIVE") @db.NVarChar(30)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  invoices  AgentInvoice[]
  payments  AgentPayment[]
  shipments Shipment[]     @relation("ShipmentClearingAgent")

  @@unique([code], map: "UQ_ClearingAgents_Code")
  @@index([status, deletedAt], map: "IX_ClearingAgents_Status_DeletedAt")
  @@map("ClearingAgents")
}

model MoneyChanger {
  id            String  @id @default(cuid()) @db.NVarChar(30)
  code          String  @db.NVarChar(30)
  name          String  @db.NVarChar(150)
  companyName   String? @db.NVarChar(180)
  licenseNumber String? @db.NVarChar(60)
  contactPerson String? @db.NVarChar(120)
  phone         String? @db.NVarChar(40)
  email         String? @db.NVarChar(180)
  city          String? @db.NVarChar(80)
  country       String? @db.NVarChar(80)
  status        String  @default("ACTIVE") @db.NVarChar(30)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  exchanges CurrencyExchange[]

  @@unique([code], map: "UQ_MoneyChangers_Code")
  @@map("MoneyChangers")
}

model CurrencyExchange {
  id             String   @id @default(cuid()) @db.NVarChar(30)
  referenceNo    String   @db.NVarChar(40)
  moneyChangerId String   @db.NVarChar(30)
  shipmentId     String?  @db.NVarChar(30)
  exchangeDate   DateTime @db.DateTime2
  fromCurrency   String   @db.NVarChar(3)
  toCurrency     String   @db.NVarChar(3)
  fromAmount     Decimal  @db.Decimal(18, 4)
  rate           Decimal  @db.Decimal(18, 8)
  toAmount       Decimal  @db.Decimal(18, 4)
  commission     Decimal  @default(0) @db.Decimal(18, 4)
  netAmount      Decimal  @db.Decimal(18, 4)
  settlementMode String   @default("CASH") @db.NVarChar(30)
  status         String   @default("COMPLETED") @db.NVarChar(30)
  remarks        String?  @db.NVarChar(400)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  moneyChanger MoneyChanger @relation(fields: [moneyChangerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipment     Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([referenceNo], map: "UQ_CurrencyExchanges_ReferenceNo")
  @@index([moneyChangerId, exchangeDate], map: "IX_CurrencyExchanges_Changer_Date")
  @@map("CurrencyExchanges")
}

// ---------------------------------------------------------------------------
// Import shipments
//
// A shipment is one consignment we import. It carries the goods value from its
// line items plus every additional cost incurred until the goods reach stock,
// which together form the landed cost.
// ---------------------------------------------------------------------------

model Shipment {
  id               String  @id @default(cuid()) @db.NVarChar(30)
  shipmentNo       String  @db.NVarChar(40)
  supplierVendorId String  @db.NVarChar(30)
  carrierVendorId  String? @db.NVarChar(30)
  clearingAgentId  String? @db.NVarChar(30)

  supplierInvoiceNo   String?   @db.NVarChar(60)
  supplierInvoiceDate DateTime? @db.DateTime2

  shipmentType  String  @default("IMPORT") @db.NVarChar(30)
  transportMode String  @db.NVarChar(30)
  serviceType   String  @default("PORT_TO_PORT") @db.NVarChar(40)
  incoterm      String? @db.NVarChar(10)
  status        String  @default("DRAFT") @db.NVarChar(40)

  originCountry      String? @db.NVarChar(80)
  originPort         String  @db.NVarChar(120)
  destinationCountry String? @db.NVarChar(80)
  destinationPort    String  @db.NVarChar(120)

  bookingNo          String? @db.NVarChar(60)
  masterBlNo         String? @db.NVarChar(60)
  houseBlNo          String? @db.NVarChar(60)
  vesselName         String? @db.NVarChar(120)
  voyageNo           String? @db.NVarChar(40)
  flightNo           String? @db.NVarChar(40)
  goodsDeclarationNo String? @db.NVarChar(60)

  cargoDescription    String? @db.NVarChar(Max)
  packageCount        Int     @default(0)
  packageType         String? @db.NVarChar(40)
  grossWeightKg       Decimal @default(0) @db.Decimal(18, 3)
  netWeightKg         Decimal @default(0) @db.Decimal(18, 3)
  volumeCbm           Decimal @default(0) @db.Decimal(18, 3)
  chargeableWeight    Decimal @default(0) @db.Decimal(18, 3)
  isHazardous         Boolean @default(false)
  requiresTempControl Boolean @default(false)

  orderDate         DateTime? @db.DateTime2
  bookingDate       DateTime? @db.DateTime2
  cargoReceivedDate DateTime? @db.DateTime2
  shippingDate      DateTime? @db.DateTime2
  expectedArrival   DateTime? @db.DateTime2
  actualArrival     DateTime? @db.DateTime2
  clearanceDate     DateTime? @db.DateTime2
  deliveryDate      DateTime? @db.DateTime2
  closedAt          DateTime? @db.DateTime2

  supplierCurrency String  @default("USD") @db.NVarChar(3)
  exchangeRate     Decimal @default(1) @db.Decimal(18, 8)
  baseCurrency     String  @default("PKR") @db.NVarChar(3)

  costAllocationBasis String @default("VALUE") @db.NVarChar(20)

  goodsValue      Decimal @default(0) @db.Decimal(18, 4)
  freightCost     Decimal @default(0) @db.Decimal(18, 4)
  dutyCost        Decimal @default(0) @db.Decimal(18, 4)
  clearingCost    Decimal @default(0) @db.Decimal(18, 4)
  otherCost       Decimal @default(0) @db.Decimal(18, 4)
  additionalCost  Decimal @default(0) @db.Decimal(18, 4)
  totalLandedCost Decimal @default(0) @db.Decimal(18, 4)
  budgetedCost    Decimal @default(0) @db.Decimal(18, 4)

  remarks String? @db.NVarChar(Max)

  createdAt   DateTime  @default(now()) @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2
  createdById String?   @db.NVarChar(30)
  updatedById String?   @db.NVarChar(30)
  deletedAt   DateTime? @db.DateTime2
  deletedById String?   @db.NVarChar(30)

  supplier      Vendor         @relation("ShipmentSupplier", fields: [supplierVendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
